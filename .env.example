# Local development (§15.1 M0a). Source this before `make dev-api`.
#
# These point at the *dev* AWS environment: the table, the CMK, and the two
# secrets are real. Nothing here is a credential — AWS access comes from your
# usual profile, and the Google client secret is read from Secrets Manager.

export AWS_PROFILE=sundial-dev
export AWS_DEFAULT_REGION=us-east-1

export SUNDIAL_ENV=dev
export SUNDIAL_TABLE_NAME=sundial-dev
export SUNDIAL_KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY-ID
export SUNDIAL_SESSION_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:sundial/dev/session-key-XXXXXX
export SUNDIAL_GOOGLE_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:sundial/dev/google-client-XXXXXX

export SUNDIAL_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
export SUNDIAL_ALLOWED_GOOGLE_ACCOUNT_ID=  # the numeric `sub` from Google, not the email
export SUNDIAL_APP_BASE_URL=http://localhost:5173
export SUNDIAL_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
